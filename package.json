{
  "name": "pulselane",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build --webpack",
    "start": "node ./node_modules/next/dist/bin/next start",
    "typecheck": "rm -f tsconfig.tsbuildinfo && node ./node_modules/next/dist/bin/next typegen && node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test --experimental-strip-types --experimental-specifier-resolution=node tests/**/*.test.ts",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:push": "node ./node_modules/prisma/build/index.js db push"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.4",
    "@prisma/client": "^6.17.0",
    "next": "^16.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prisma": "^6.17.0",
    "typescript": "^5.9.3"
  }
}
